{:paths ["src"]
 ;; The native host, window and every provider effect belong to
 ;; kotoba-lang/shell -- this repo only supplies the pure entry
 ;; (local-itonami.shell-app/start) it calls. shell is intentionally NOT a
 ;; :deps entry: it is a CLI/host, invoked as `kotoba-shell app ...`, not a
 ;; library this classpath links against.
 ;;
 ;; jp-go-digital-design-system supplies the DADS skin's vendored CSS and the
 ;; --hig-* token bridge (jp-go-dds.tokens/skin-css). The class *names* used
 ;; by local-itonami.skin are plain strings, so the JVM test suite runs
 ;; without it; the dep is needed by the web/SSR build that emits real CSS.
 :deps {
        ;; kotoba.lang.coll replaced clojure.walk here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll's walk rebuilds real map entries from e88106f,
        ;; and tools.deps takes the NEWEST sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "f74e248f0a07e8ae572885f50fab6bdb39dc24be"}
        ;; kotoba.test (clojure.test-compatible surface), not clojure.test --
        ;; scripts/migrate-clojure-test-to-kotoba-test.cljk. Explicit floor.
        io.github.kotoba-lang/test {:git/url "https://github.com/kotoba-lang/test.git"
                                    :git/sha "2ab4885f99fd25552d380d0f6b0b54c5a72eb7ae"}
        ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.4"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:local/root "../../kotoba-lang/jp-go-digital-design-system"}
        io.github.kotoba-lang/html {:local/root "../../kotoba-lang/html"}
        ;; Domain-restricted access (local-itonami.access). authentication
        ;; supplies email normalisation + the provider-neutral identity
        ;; profile; authorization supplies the deny-by-default rules engine
        ;; that actually decides. The split is deliberate -- see the ns
        ;; docstring for why the domain check is NOT an authn factor.
        io.github.kotoba-lang/authentication
        {:local/root "../../kotoba-lang/authentication"}
        io.github.kotoba-lang/authorization
        {:local/root "../../kotoba-lang/authorization"}
        ;; The portable JUDGMENT half of OIDC sign-in (local-itonami.signin).
        ;; Both are zero-dep .cljc and deliberately do no network and no
        ;; crypto -- org-openid-oidc's README says it outright: signature
        ;; verification is the host's job. That split is the whole answer to
        ;; "what language is the host provider written in".
        io.github.kotoba-lang/org-ietf-oauth2
        {:local/root "../../kotoba-lang/org-ietf-oauth2"}
        io.github.kotoba-lang/org-openid-oidc
        {:local/root "../../kotoba-lang/org-openid-oidc"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; kbb -M:web [out-dir] -> writes the WKWebView bundle :web/dist-dir
  ;; points at. Same hiccup views the native kotoba:dom path compiles.
  :web {:main-opts ["-m" "local-itonami.web"]}
  ;; shadow-cljs の browser build 用。cljs 本体はここでだけ要る
  ;; (JVM のテストと :web の SSR には不要)。
  :cljs-build {:extra-deps {org.clojure/clojurescript {:mvn/version "1.11.132"}
                            thheller/shadow-cljs {:mvn/version "2.28.20"}}}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
