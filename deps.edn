{:paths ["src"]
 ;; The native host, window and every provider effect belong to
 ;; kotoba-lang/shell -- this repo only supplies the pure entry
 ;; (local-itonami.shell-app/start) it calls. shell is intentionally NOT a
 ;; :deps entry: it is a CLI/host, invoked as `kotoba-shell app ...`, not a
 ;; library this classpath links against.
 ;;
 ;; jp-go-digital-design-system supplies the DADS skin's vendored CSS and the
 ;; --hig-* token bridge (jp-go-dds.tokens/skin-css). The class *names* used
 ;; by local-itonami.skin are plain strings, so the JVM test suite runs
 ;; without it; the dep is needed by the web/SSR build that emits real CSS.
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        io.github.kotoba-lang/jp-go-digital-design-system
        {:local/root "../../kotoba-lang/jp-go-digital-design-system"}
        io.github.kotoba-lang/html {:local/root "../../kotoba-lang/html"}}
 :aliases
 {:test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; clojure -M:web [out-dir] -> writes the WKWebView bundle :web/dist-dir
  ;; points at. Same hiccup views the native kotoba:dom path compiles.
  :web {:main-opts ["-m" "local-itonami.web"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
